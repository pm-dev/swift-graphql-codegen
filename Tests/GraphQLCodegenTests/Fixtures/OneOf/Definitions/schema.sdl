type Query {
  search(by: SearchInput!): String!
}

input SearchInput @oneOf {
  id: Int
  name: String @deprecated(reason: "Use id.")
  tags: [String!]
  next: SearchInput
  filter: SearchFilterInput
  CodingKeys: String
}

input SearchFilterInput @oneOf {
  name: String
  search: SearchInput @deprecated(reason: "Use name.")
}
