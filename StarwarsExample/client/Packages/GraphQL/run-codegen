#!/bin/sh

# Demonstrates running the standalone graphql-codegen executable with a JSON configuration file.
# Uses the config graphql-codegen.json in the same directory as this script.

set -eu

script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_directory=$(CDPATH= cd -- "$script_directory/../../../.." && pwd)

exec swift run --package-path "$repository_directory" graphql-codegen \
    --file-configuration "$script_directory/graphql-codegen.json"
